<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows parancssori letöltő (PLAN-3.0 9.2, átmeneti – 1.7): a 2.x Letolto.cs változatlan logikával. A Megjelenítő (asztali gazda)
       külön folyamatként indítja, a Feladatütemező is ezt futtatja. A DownloadEngine (S3) váltja ki a belsejét. -->
  <PropertyGroup>
    <!-- ablak nélküli program, mint a 2.x-ben (/target:winexe): ütemezve nem villan fel konzolablak; a konzolt maga kéri (AttachConsole/AllocConsole) -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- a riasztás Windows-értesítése (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>WStation – Letöltő</AssemblyTitle>
    <!-- ugyanaz az ikon, mint a Megjelenítőé (a 2.x build is ugyanazt az app.ico-t adta mindkettőnek) -->
    <ApplicationIcon>..\WStation.Desktop\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WStation.Core\WStation.Core.csproj" />
  </ItemGroup>
  <!-- Közös kimenet (1.7): a telepített programban a letöltő a Megjelenítő mellett van, ugyanabban a mappában (Layout.FindDownloader
       ott keresi). Ezért a letöltő saját fájljai fordításkor az asztali gazda kimeneti mappájába is átkerülnek, így a fordítás
       kimenetéből indított asztali program Frissítés gombja megtalálja. Ez csak másolás, nem hivatkozás (a gazdák egymásra nem
       hivatkoznak – PLAN-3.0 4.3); a közös WStation.Core.dll-t az asztali gazda maga hozza. A takarítás (clean) a másolatokat is törli. -->
  <Target Name="KozosKimenet" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <KozosKimenetMappa>$(MSBuildThisFileDirectory)..\WStation.Desktop\bin\$(Configuration)\$(TargetFramework)\</KozosKimenetMappa>
    </PropertyGroup>
    <ItemGroup>
      <KozosKimenetFajl Include="$(OutDir)$(AssemblyName).exe;$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb;$(OutDir)$(AssemblyName).deps.json;$(OutDir)$(AssemblyName).runtimeconfig.json" />
      <KozosKimenetFajl Remove="@(KozosKimenetFajl)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(KozosKimenetFajl)" DestinationFolder="$(KozosKimenetMappa)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(KozosKimenetFajl->'$(KozosKimenetMappa)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
