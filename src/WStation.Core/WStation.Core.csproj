<Project Sdk="Microsoft.NET.Sdk">
  <!-- A közös mag: nem hivatkozhat a src többi projektjére, és nem használhat Windows-függő elemet (PLAN-3.0 4.3). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A Windows-telepítő tartalma önálló (self-contained) win-x64 kiadás (packaging/windows, PLAN-3.0 9.4): a visszaállítás
         (és a zárolófájl) ezért a win-x64 változatot is tartalmazza; a sima fordításon ez nem változtat. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- A nyelvi fájlok (a Langs a saját szerelvényéből olvassa őket, „web/lang/<kód>.json” néven); a „_” kezdetűek nem. -->
    <EmbeddedResource Include="..\..\web\lang\*.json" Exclude="..\..\web\lang\_*.json" LogicalName="web/lang/%(Filename)%(Extension)" />
    <!-- A felület (PLAN-3.0 12.): a web mappa minden fájlja mintával, „web/<név>” néven – a helyi szerver (HttpListenerFront)
         innen szolgálja ki; új fájlnál a projektfájlt nem kell módosítani. A „_” kezdetűek (sablonok) kimaradnak. -->
    <EmbeddedResource Include="..\..\web\*" Exclude="..\..\web\_*" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- IDEIGLENES (1.5): az átvett 2.x-osztályok belsők (internal); a gazdák (asztali, letöltő – 1.7) és a tesztek így érik el őket. -->
    <InternalsVisibleTo Include="WStation.Desktop" />
    <InternalsVisibleTo Include="WStation.Downloader" />
    <InternalsVisibleTo Include="WStation.Tests" />
  </ItemGroup>
</Project>
